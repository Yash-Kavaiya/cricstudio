# Vercel Container Runtime image — serves the web app, REST API, Socket.IO, FFmpeg relays and the
# headless-Chromium cloud producer from one origin.
# Note: Vercel scales an instance down after ~5 min without inbound requests, so the cloud producer
# runs while the studio has visitors/hosts connected; it is not a guaranteed 24/7 worker here.
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN npm ci --no-audit --no-fund
RUN npm run build -w @cricstudio/web && npm run build -w @cricstudio/server && npm prune --omit=dev --no-audit --no-fund

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg chromium fonts-noto-color-emoji fonts-roboto ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# /tmp is the writable scratch area; set DATABASE_URL (Postgres) for studios that survive scale-down
ENV NODE_ENV=production PORT=80 DATA_DIR=/tmp/cricstudio STREAMING_DISABLED=1 CHROME_PATH=/usr/bin/chromium WORKER_MAX_HEAP_MB=700
COPY --from=build /app /app
EXPOSE 80
CMD ["node", "apps/server/dist/index.js"]
