{
  "name": "@cricstudio/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build.mjs && concurrently -k -r \"node build.mjs --watch\" \"node --watch-path=dist --watch-preserve-output dist/index.js\"",
    "start": "node dist/index.js",
    "start:ts": "tsx src/index.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cricstudio/cricket-engine": "*",
    "@cricstudio/shared": "*",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1",
    "msedge-tts": "^2.1.0",
    "puppeteer-core": "^25.14.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "esbuild": "^0.25.0"
  },
  "optionalDependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.4.2",
    "livekit-server-sdk": "^2.9.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "socket.io-client": "^4.8.1",
    "vitest": "^3.0.5"
  }
}
